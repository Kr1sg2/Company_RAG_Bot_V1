# AI-Bridge watcher environment (copy to /etc/lexa/ai-bridge.env)
LEXA_INBOX_DIR=/home/bizbots24/ai-bridge/inbox
LEXA_PROCESSED_DIR=/home/bizbots24/ai-bridge/inbox/.processed
LEXA_ACCEPT_EXTS=.diff,.patch,.json,.txt
LEXA_BACKEND_URL=http://127.0.0.1:8601
# Optional: shell command to notify on new file (e.g., 'logger "lexa watcher event"')
# Leave blank to disable.
LEXA_NOTIFY_CMD=
